# Copy to Vercel Project Settings > Environment Variables (Preview first).
# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend config (only the anon key is safe to expose; service role is server-only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI API key must remain server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Exact production/preview origin, e.g. https://your-preview-domain.vercel.app
APP_ORIGIN=

# Optional Resend integration (configure domain verification before enabling sending).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
